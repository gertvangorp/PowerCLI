{
  "_comment": "One file per environment (lab, customer, ...), shared by all scripts. Copy to config\\<name>.config.json (for example lab1.config.json) and run a script with -Environment <name>, or use -ConfigFile <path>. Every script reads the top-level keys, then Common, then its own section; a later one wins. Never put passwords here: use <X>User (the script prompts) or <X>CredentialFile (Get-Credential | Export-Clixml <file>).",
  "Environment": "lab1",
  "Common": {
    "SddcManager": "sddc01.lab1.local",
    "VCenter": "vc01.lab1.local",
    "SddcUser": "administrator@vsphere.local",
    "_SddcCredentialFile": "%USERPROFILE%\\creds\\lab1-sddc.xml",
    "VcUser": "administrator@vsphere.local",
    "_VcCredentialFile": "%USERPROFILE%\\creds\\lab1-vc.xml",
    "EsxiUser": "root",
    "UseSddcCredentials": false,
    "SkipCertificateCheck": true
  },
  "PrimaryDatastore": {},
  "LunMultipathReport": {
    "VMHost": ["esx01.lab1.local"],
    "CsvPath": "%USERPROFILE%\\Reports\\{env}-lun-report-{date}.csv"
  },
  "TpmRecoveryKey": {
    "Cluster": ["cl01"],
    "CsvPath": ""
  },
  "EsxiNtpServer": {
    "VMHost": ["esx01.lab1.local", "esx02.lab1.local"],
    "NtpServer": ["0.be.pool.ntp.org", "1.be.pool.ntp.org"]
  },
  "VcfBackupSettings": {
    "_comment": "Used by Export-VcfBackupSettings and Set-VcfBackupSettings. VCenter here overrides Common. The SFTP password and the encryption passphrase are never stored here: SftpUser (prompt) or SftpCredentialFile, EncryptionCredentialFile (or prompt).",
    "VCenter": ["vc01.lab1.local"],
    "FleetManager": "",
    "_FleetUser": "admin@local",
    "OutputPath": "%USERPROFILE%\\Reports\\vcf-backup-settings\\{env}",
    "IncludeJobHistory": false,
    "SftpUser": "svc-vcfbackup",
    "_SftpCredentialFile": "%USERPROFILE%\\creds\\lab1-sftp.xml",
    "_EncryptionCredentialFile": "%USERPROFILE%\\creds\\lab1-backup-encryption.xml",
    "BackupTarget": {
      "Server": "sftp01.lab1.local",
      "Port": 22,
      "SshFingerprint": "SHA256:REPLACE_WITH_SFTP_HOST_KEY_FINGERPRINT"
    },
    "SddcManagerBackup": {
      "Enabled": true,
      "DirectoryPath": "/backups/sddc",
      "Frequency": "WEEKLY",
      "DaysOfWeek": ["SUNDAY", "WEDNESDAY"],
      "HourOfTheDay": 2,
      "MinuteOfTheHour": 0,
      "TakeBackupOnStateChange": true,
      "RetainMostRecent": 5,
      "RetainHourlyDays": 1,
      "RetainDailyDays": 7
    },
    "VCenterBackup": {
      "Enabled": true,
      "ScheduleId": "default",
      "DirectoryPath": "/backups/vcenter/{vcenter}",
      "IncludeStatsEventsTasks": false,
      "Days": ["MONDAY", "TUESDAY", "WEDNESDAY", "THURSDAY", "FRIDAY", "SATURDAY", "SUNDAY"],
      "Hour": 23,
      "Minute": 0,
      "MaxCount": 7
    }
  }
}
